{
    "version" : 3,
    "configurePresets" : [
        {
            "name" : "default",
            "generator" : "Ninja",
            "binaryDir" : "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE" : "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS" : "ON",
                "CMAKE_CXX_COMPILER_LAUNCHER" : "ccache",
                "CMAKE_CXX_FLAGS" : "-Wall -Wextra -Wpedantic -Werror -Wshadow"     
            }
        }
    ]
}